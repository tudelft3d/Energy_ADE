FACTORY_DEF {*} TestFactory FACTORY_NAME { $(XLinkUpdater_WORKSPACE_NAME)_TestFilter } INPUT FEATURE_TYPE $(XLinkUpdater_WORKSPACE_NAME)_TestFilter_INPUTLINE FEATURE_TABLE_SHIM_SUPPORT Yes PASSED_TEST_GROUP_OUTPUT FIRST TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>is_xlink<closeparen>,$(XLinkUpdater_WORKSPACE_NAME)_TestFilter) = 0 ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>is_xlink_new<closeparen>,$(XLinkUpdater_WORKSPACE_NAME)_TestFilter) = 0 ENCODED } BOOLEAN_OPERATOR AND COMPOSITE_TEST_EXPR "1 AND 2" OUTPUT PASSED_0 FEATURE_TYPE $(XLinkUpdater_WORKSPACE_NAME)_TestFilter_no<space>change TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>is_xlink<closeparen>,$(XLinkUpdater_WORKSPACE_NAME)_TestFilter) = 0 ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>is_xlink_new<closeparen>,$(XLinkUpdater_WORKSPACE_NAME)_TestFilter) = 1 ENCODED } BOOLEAN_OPERATOR AND COMPOSITE_TEST_EXPR "1 AND 2" OUTPUT PASSED_1 FEATURE_TYPE $(XLinkUpdater_WORKSPACE_NAME)_TestFilter_0<space>1 TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>is_xlink<closeparen>,$(XLinkUpdater_WORKSPACE_NAME)_TestFilter) = 0 ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>is_xlink_new<closeparen>,$(XLinkUpdater_WORKSPACE_NAME)_TestFilter) = 2 ENCODED } BOOLEAN_OPERATOR AND COMPOSITE_TEST_EXPR "1 AND 2" OUTPUT PASSED_2 FEATURE_TYPE $(XLinkUpdater_WORKSPACE_NAME)_TestFilter_0<space>2 TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>is_xlink<closeparen>,$(XLinkUpdater_WORKSPACE_NAME)_TestFilter) = 1 ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>is_xlink_new<closeparen>,$(XLinkUpdater_WORKSPACE_NAME)_TestFilter) = 0 ENCODED } BOOLEAN_OPERATOR AND COMPOSITE_TEST_EXPR "1 AND 2" OUTPUT PASSED_3 FEATURE_TYPE $(XLinkUpdater_WORKSPACE_NAME)_TestFilter_1<space>0 TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>is_xlink<closeparen>,$(XLinkUpdater_WORKSPACE_NAME)_TestFilter) = 1 ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>is_xlink_new<closeparen>,$(XLinkUpdater_WORKSPACE_NAME)_TestFilter) = 1 ENCODED } BOOLEAN_OPERATOR AND COMPOSITE_TEST_EXPR "1 AND 2" OUTPUT PASSED_4 FEATURE_TYPE $(XLinkUpdater_WORKSPACE_NAME)_TestFilter_no<space>change TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>is_xlink<closeparen>,$(XLinkUpdater_WORKSPACE_NAME)_TestFilter) = 1 ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>is_xlink_new<closeparen>,$(XLinkUpdater_WORKSPACE_NAME)_TestFilter) = 2 ENCODED } BOOLEAN_OPERATOR AND COMPOSITE_TEST_EXPR "1 AND 2" OUTPUT PASSED_5 FEATURE_TYPE $(XLinkUpdater_WORKSPACE_NAME)_TestFilter_1<space>2 TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>is_xlink<closeparen>,$(XLinkUpdater_WORKSPACE_NAME)_TestFilter) = 2 ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>is_xlink_new<closeparen>,$(XLinkUpdater_WORKSPACE_NAME)_TestFilter) = 0 ENCODED } BOOLEAN_OPERATOR AND COMPOSITE_TEST_EXPR "1 AND 2" OUTPUT PASSED_6 FEATURE_TYPE $(XLinkUpdater_WORKSPACE_NAME)_TestFilter_2<space>0 TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>is_xlink<closeparen>,$(XLinkUpdater_WORKSPACE_NAME)_TestFilter) = 2 ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>is_xlink_new<closeparen>,$(XLinkUpdater_WORKSPACE_NAME)_TestFilter) = 1 ENCODED } BOOLEAN_OPERATOR AND COMPOSITE_TEST_EXPR "1 AND 2" OUTPUT PASSED_7 FEATURE_TYPE $(XLinkUpdater_WORKSPACE_NAME)_TestFilter_2<space>1 TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>is_xlink<closeparen>,$(XLinkUpdater_WORKSPACE_NAME)_TestFilter) = 2 ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>is_xlink_new<closeparen>,$(XLinkUpdater_WORKSPACE_NAME)_TestFilter) = 2 ENCODED } BOOLEAN_OPERATOR AND COMPOSITE_TEST_EXPR "1 AND 2" OUTPUT PASSED_8 FEATURE_TYPE $(XLinkUpdater_WORKSPACE_NAME)_TestFilter_no<space>change OUTPUT FAILED FEATURE_TYPE $(XLinkUpdater_WORKSPACE_NAME)_TestFilter_<lt>UNFILTERED<gt>
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(XLinkUpdater_WORKSPACE_NAME)_TestFilter <lt>UNFILTERED<gt> Transformer Output Nuker"   INPUT FEATURE_TYPE "$(XLinkUpdater_WORKSPACE_NAME)_TestFilter_<lt>UNFILTERED<gt>"
