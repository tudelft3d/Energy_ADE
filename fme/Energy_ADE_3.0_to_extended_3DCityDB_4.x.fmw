FACTORY_DEF {*} ReferenceFactory    FACTORY_NAME { $(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9 }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    INPUT REFERENCER FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_CityGMLClassRenamer_AttributeRemover_3_Output"    INPUT REFERENCEE FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_AttributeKeeper_OUTPUT"    REFERENCE_INFO { $($(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_REFERENCE_INFO) }    REFERENCE_TABLE { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>objectclass_name<closeparen>,$(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9) @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>objectclass_name<closeparen>,$(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9) AUTO }    ATTR_ACCUM_MODE { "HANDLE_CONFLICT" }    ATTR_CONFLICT_RES { "REQUESTOR_IF_CONFLICT" }    IGNORE_NULLS { "No" }    HANDLE_NULL_MISSING_KEYS_LIKE_FME2013 { No }    LIST_ATTRS_TO_INCLUDE { <Unused> }    LIST_ATTRS_TO_INCLUDE_MODE { <Unused> }    MERGE_ATTRIBUTES Yes    MANAGE_FME_TYPE Yes    MODE COMPLETE    PROCESS_DUPLICATE_REFERENCEES { NO }    REFERENCEES_FIRST { No }    REJECT_INVALID_GEOM YES    CLEANING_TOLERANCE { <Unused> }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    COMPARE_WHITESPACE Yes    OUTPUT { COMPLETE FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_MERGED"         }    OUTPUT { INCOMPLETE FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_UNMERGED_REQUESTOR"         }
