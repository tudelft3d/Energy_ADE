nnection<apos><comma><lf><tab><apos>MonthlyTimeSeries<apos><comma><apos>MonthlyTimeSeriesFile<apos><comma><apos>TypicalValuesMonthlyTimeSeries<apos><comma><apos>TypicalValuesMonthlyTimeSeriesFile<apos><comma><lf><tab><apos>IrregularTimeSeries<apos><comma><apos>IrregularTimeSeriesFile<apos><comma><apos>TypicalValuesIrregularTimeSeries<apos><comma><apos>TypicalValuesIrregularTimeSeriesFile<apos><closeparen><semicolon><lf><lf>--<space>Schedules<space>module<lf>SELECT<space>$(citydb_schema$encode).del_ng3_schedule<openparen>co.id<closeparen><space>FROM<space>$(citydb_schema$encode).cityobject<space>AS<space>co<space>JOIN<space>$(citydb_schema$encode).objectclass<space>AS<space>o<space>ON<space><openparen>co.objectclass_id<space>=<space>o.id<closeparen><lf><tab>WHERE<space>o.classname<space>IN<space><openparen><apos>ConstantValueSchedule<apos><comma><space><apos>DualValueSchedule<apos><comma><space><apos>TimeSeriesSchedule<apos><comma><space><apos>CompositeSchedule<apos><closeparen><semicolon><lf>SELECT<space>$(citydb_schema$encode).del_ng3_schedule_component<openparen>co.id<closeparen><space>FROM<space>$(citydb_schema$encode).cityobject<space>AS<space>co<space>JOIN<space>$(citydb_schema$encode).objectclass<space>AS<space>o<space>ON<space><openparen>co.objectclass_id<space>=<space>o.id<space>AND<space>o.classname=<apos>ScheduleComponent<apos><closeparen><semicolon><lf>SELECT<space>$(citydb_schema$encode).del_ng3_library<openparen>co.id<closeparen><space>FROM<space>$(citydb_schema$encode).cityobject<space>AS<space>co<space>JOIN<space>$(citydb_schema$encode).objectclass<space>AS<space>o<space>ON<space><openparen>co.objectclass_id<space>=<space>o.id<space>AND<space>o.classname=<apos>ScheduleLibrary<apos><closeparen><semicolon><lf><lf>--<space>Layered<space>Construction<space>module<lf>SELECT<space>$(citydb_schema$encode).del_ng3_material<openparen>co.id<closeparen><space>FROM<space>$(citydb_schema$encode).cityobject<space>AS<space>co<space>JOIN<space>$(citydb_schema$encode)