# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split "_list<opencurly><closecurly>"] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(CityGMLClassRenamer_WORKSPACE_NAME)_AttributeRemover_3_LIST_FUNC }    } else {        puts "MACRO $(CityGMLClassRenamer_WORKSPACE_NAME)_AttributeRemover_3_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(CityGMLClassRenamer_WORKSPACE_NAME)_AttributeRemover_3 }    INPUT  FEATURE_TYPE "$(CityGMLClassRenamer_WORKSPACE_NAME)_Junction_Output"    INPUT  FEATURE_TYPE "$(CityGMLClassRenamer_WORKSPACE_NAME)_Junction_2_Output"    INPUT  FEATURE_TYPE "$(CityGMLClassRenamer_WORKSPACE_NAME)_Junction_3_Output"    INPUT  FEATURE_TYPE "$(CityGMLClassRenamer_WORKSPACE_NAME)_AttributeFilter_<lt>UNFILTERED<gt>"    OUTPUT { FEATURE_TYPE "$(CityGMLClassRenamer_WORKSPACE_NAME)_AttributeRemover_3_OUTPUT"        @RemoveAttributes(fme_encoded,objectclass_name_prefix,fme_feature_type,objectclass_name_prefix2)        $($(CityGMLClassRenamer_WORKSPACE_NAME)_AttributeRemover_3_LIST_FUNC)         }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(CityGMLClassRenamer_WORKSPACE_NAME)_AttributeRemover_3_Output1778766684 Output Collector"   INPUT FEATURE_TYPE "$(CityGMLClassRenamer_WORKSPACE_NAME)_AttributeRemover_3_OUTPUT"   OUTPUT FEATURE_TYPE "$(CityGMLClassRenamer_WORKSPACE_NAME)_AttributeRemover_3_Output"
INCLUDE [puts {MACRO WB_CURRENT_CONTEXT $(WB_OLD_CONTEXT_$(CityGMLClassRenamer_WORKSPACE_NAME))}]
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(ADE_CityObject_editor_WORKSPACE_NAME)_CityGMLClassRenamer AttributeRemover_3_Output Output Renamer/Nuker"   INPUT FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_CityGMLClassRenamer_AttributeRemover_3_Output"   OUTPUT FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_CityGMLClassRenamer_AttributeRemover_3_Output"
# -------------------------------------------------------------------------
INCLUDE [if { {ATTRIBUTES} == {ATTRIBUTES} } {                puts "MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_REFERENCE_INFO ATTRIBUTES";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} && {<Unused>} == {POLYGONS}} {                puts "MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_REFERENCE_INFO GEOM_BUILD_POLYS";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} && {<Unused>} == {AGGREGATES}} {                puts "MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_REFERENCE_INFO GEOM_BUILD_AGGREGATES";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} && {<Unused>} == {LINESFROMPOINTS}} {                puts "MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_REFERENCE_INFO GEOM_BUILD_LINES_FROM_POINTS";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} && {<Unused>} == {POLYGONS}} {                puts "MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_REFERENCE_INFO GEOM_AND_ATTR_BUILD_POLYS";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} && {<Unused>} == {AGGREGATES}} {                puts "MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_REFERENCE_INFO GEOM_AND_ATTR_BUILD_AGGREGATES";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} && {<Unused>} == {LINESFROMPOINTS}} {                puts "MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_REFERENCE_INFO GEOM_AND_ATTR_BUILD_LINES_FROM_POINTS";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} } {                puts "MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_REFERENCE_INFO GEOM_BUILD_AGGREGATES";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} } {                puts "MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_REFERENCE_INFO GEOM_AND_ATTR_BUILD_AGGREGATES";             }          else {}; ]
FACTORY_DEF {*} ReferenceFactory    FACTORY_NAME { $(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9 }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    INPUT REFERENCER FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_CityGMLClassRenamer_AttributeRemover_3_Output"    INPUT REFERENCEE FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_AttributeKeeper_OUTPUT"    REFERENCE_INFO { $($(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_REFERENCE_INFO) }    REFERENCE_TABLE { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>objectclass_name<closeparen>,$(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9) @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>objectclass_name<closeparen>,$(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9) AUTO }    ATTR_ACCUM_MODE { "HANDLE_CONFLICT" }    ATTR_CONFLICT_RES { "REQUESTOR_IF_CONFLICT" }    IGNORE_NULLS { "No" }    HANDLE_NULL_MISSING_KEYS_LIKE_FME2013 { No }    LIST_ATTRS_TO_INCLUDE { <Unused> }    LIST_ATTRS_TO_INCLUDE_MODE { <Unused> }    MERGE_ATTRIBUTES Yes    MANAGE_FME_TYPE Yes    MODE COMPLETE    PROCESS_DUPLICATE_REFERENCEES { NO }    REFERENCEES_FIRST { No }    REJECT_INVALID_GEOM YES    CLEANING_TOLERANCE { <Unused> }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    COMPARE_WHITESPACE Yes    OUTPUT { COMPLETE FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_MERGED"         }    OUTPUT { INCOMPLETE FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_UNMERGED_REQUESTOR"         }
# -------------------------------------------------------------------------
