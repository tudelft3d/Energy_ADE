INCLUDE [if { {ATTRIBUTES} == {ATTRIBUTES} } {                puts "MACRO $(QualifiedAttributeWriter_WORKSPACE_NAME)_FeatureMerger_3_REFERENCE_INFO ATTRIBUTES";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} && {<Unused>} == {POLYGONS}} {                puts "MACRO $(QualifiedAttributeWriter_WORKSPACE_NAME)_FeatureMerger_3_REFERENCE_INFO GEOM_BUILD_POLYS";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} && {<Unused>} == {AGGREGATES}} {                puts "MACRO $(QualifiedAttributeWriter_WORKSPACE_NAME)_FeatureMerger_3_REFERENCE_INFO GEOM_BUILD_AGGREGATES";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} && {<Unused>} == {LINESFROMPOINTS}} {                puts "MACRO $(QualifiedAttributeWriter_WORKSPACE_NAME)_FeatureMerger_3_REFERENCE_INFO GEOM_BUILD_LINES_FROM_POINTS";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} && {<Unused>} == {POLYGONS}} {                puts "MACRO $(QualifiedAttributeWriter_WORKSPACE_NAME)_FeatureMerger_3_REFERENCE_INFO GEOM_AND_ATTR_BUILD_POLYS";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} && {<Unused>} == {AGGREGATES}} {                puts "MACRO $(QualifiedAttributeWriter_WORKSPACE_NAME)_FeatureMerger_3_REFERENCE_INFO GEOM_AND_ATTR_BUILD_AGGREGATES";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} && {<Unused>} == {LINESFROMPOINTS}} {                puts "MACRO $(QualifiedAttributeWriter_WORKSPACE_NAME)_FeatureMerger_3_REFERENCE_INFO GEOM_AND_ATTR_BUILD_LINES_FROM_POINTS";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} } {                puts "MACRO $(QualifiedAttributeWriter_WORKSPACE_NAME)_FeatureMerger_3_REFERENCE_INFO GEOM_BUILD_AGGREGATES";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} } {                puts "MACRO $(QualifiedAttributeWriter_WORKSPACE_NAME)_FeatureMerger_3_REFERENCE_INFO GEOM_AND_ATTR_BUILD_AGGREGATES";             }          else {}; ]
FACTORY_DEF {*} ReferenceFactory    FACTORY_NAME { $(QualifiedAttributeWriter_WORKSPACE_NAME)_FeatureMerger_3 }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    INPUT REFERENCER FEATURE_TYPE "$(QualifiedAttributeWriter_WORKSPACE_NAME)_AttributeRenamer_2_OUTPUT"    INPUT REFERENCEE FEATURE_TYPE "$(QualifiedAttributeWriter_WORKSPACE_NAME)_AttributeFilter_2_QualifiedHeight"    INPUT REFERENCEE FEATURE_TYPE "$(QualifiedAttributeWriter_WORKSPACE_NAME)_AttributeFilter_2_QualifiedArea"    INPUT REFERENCEE FEATURE_TYPE "$(QualifiedAttributeWriter_WORKSPACE_NAME)_AttributeFilter_2_QualifiedVolume"    REFERENCE_INFO { $($(QualifiedAttributeWriter_WORKSPACE_NAME)_FeatureMerger_3_REFERENCE_INFO) }    REFERENCE_TABLE { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>objectclass_name<closeparen>,$(QualifiedAttributeWriter_WORKSPACE_NAME)_FeatureMerger_3) @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>objectclass_name<closeparen>,$(QualifiedAttributeWriter_WORKSPACE_NAME)_FeatureMerger_3) AUTO }    ATTR_ACCUM_MODE { "HANDLE_CONFLICT" }    ATTR_CONFLICT_RES { "REQUESTOR_IF_CONFLICT" }    IGNORE_NULLS { "No" }    HANDLE_NULL_MISSING_KEYS_LIKE_FME2013 { No }    LIST_ATTRS_TO_INCLUDE { <Unused> }    LIST_ATTRS_TO_INCLUDE_MODE { <Unused> }    MERGE_ATTRIBUTES Yes    MANAGE_FME_TYPE Yes    MODE COMPLETE    PROCESS_DUPLICATE_REFERENCEES { NO }    REFERENCEES_FIRST { No }    REJECT_INVALID_GEOM YES    CLEANING_TOLERANCE { <Unused> }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    COMPARE_WHITESPACE Yes    OUTPUT { COMPLETE FEATURE_TYPE "$(QualifiedAttributeWriter_WORKSPACE_NAME)_FeatureMerger_3_MERGED"         }
